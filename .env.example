# SDLC Agent Framework — Environment Variables
# Copy to .env and fill in your values (never commit .env)
#
# Usage: source .env  OR  add to ~/.zshrc / ~/.bashrc

# ── Required ──────────────────────────────────────────────────────────────────

# Absolute path to this repository
AGENTS_ROOT=/path/to/sdlc-agent-framework

# Python interpreter inside the venv (created by `make install`)
AGENTS_VENV=~/.sdlc-agents-venv/bin/python

# Project name — used to namespace Weaviate collections
AGENTS_PROJECT=myapp

# Primary language of the indexed project.
# Used to add a language-aware query variant in multi-query mode.
# Values: typescript, javascript, python, java, kotlin, php, go, ruby, rust, csharp, swift, scala
AGENTS_LANGUAGE=typescript

# ── Weaviate ──────────────────────────────────────────────────────────────────

AGENTS_WEAVIATE_URL=http://localhost:8090

# Only needed if gRPC port differs from HTTP port + 1 (default: HTTP+1)
# AGENTS_WEAVIATE_GRPC_PORT=8091

# ── MCP Servers (optional) ────────────────────────────────────────────────────

# Jira — used by /solution and /configure commands
# JIRA_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=your-api-token

# GitHub — used by /pr-review and /update-pr-kb commands
# GITHUB_TOKEN=ghp_your_token_here
